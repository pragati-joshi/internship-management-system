<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.placement.controller.MainShellController">
    <top>
        <HBox styleClass="header-bar" spacing="10" alignment="CENTER_RIGHT">
            <Label text="Welcome, User" styleClass="user-label" />
            <Label fx:id="userRoleLabel" text="Role: Student" styleClass="role-badge" />
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button" />
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="15">
            <Label text="Navigation" styleClass="sidebar-title" />
            <Button text="Dashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Applications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Evaluations" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <Label text="Dashboard Content Goes Here..." />
        </StackPane>
    </center>
</BorderPane>
