<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20" styleClass="login-container" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.placement.controller.LoginController">
    <Label text="Internship &amp; Placement System" styleClass="header-label" />
    
    <VBox spacing="10" maxWidth="300" styleClass="login-card">
        <TextField fx:id="usernameField" promptText="Username / Email" styleClass="input-field" />
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-field" />
        <ComboBox fx:id="roleSelector" maxWidth="Infinity" styleClass="input-field" />
        <Button text="Login" fx:id="loginButton" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button" />
    </VBox>
</VBox>
